{
  "name": "dsh-qwenwork-bridge",
  "displayName": "DSH 千问办公 Bridge",
  "description": "把千问办公（QwenWork）自带的模型接进 DeepSeek Harness — bring the QwenWork desktop app's built-in models into DeepSeek Harness with zero configuration.",
  "version": "0.2.0",
  "author": "clown-lee",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "qwenwork",
    "千问办公",
    "qwen",
    "models",
    "llm",
    "bridge",
    "model-provider",
    "gateway"
  ],
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.2.2-rc.3"
  },
  "icon": "./icon.svg",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "assets",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clown-lee/dsh-qwenwork-bridge.git"
  },
  "homepage": "https://github.com/clown-lee/dsh-qwenwork-bridge#readme",
  "bugs": {
    "url": "https://github.com/clown-lee/dsh-qwenwork-bridge/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-llm-pi-ai": "^0.2.2-rc.3",
    "@deepseek-ai/schemastery": "^3.19.0",
    "@earendil-works/pi-ai": "^1.3.0"
  }
}
